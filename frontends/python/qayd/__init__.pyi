    def __eq__(self, rhs: Union[int, CustomerValue]) -> VisitConstraint: ...  # type: ignore[override]
    def __hash__(self) -> int: ...


class RouteSet:
    """A set of visible routes over a customer set."""

    customers: CustomerSet
    depot: int
