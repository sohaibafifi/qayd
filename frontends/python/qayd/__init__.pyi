# sum() dispatches: a route + lambda or an iterable of Terms build a Term;
# an iterable of arithmetic operands (Expr/IntVar/int) builds an Expr.
@overload
def sum(arg: ListVar, func: _Body1) -> Term: ...
@overload
def sum(arg: Iterable[Term]) -> Term: ...
@overload
def sum(arg: Iterable[_IntoExpr]) -> Expr: ...


def minimum(route: ListVar, func: _Body1) -> Term:
    """``min(route, i => body)`` over a route's items."""
    ...


def maximum(route: ListVar, func: _Body1) -> Term:
    """``max(route, i => body)`` over a route's items."""
    ...


def count(route: ListVar, func: Optional[_Body1] = ...) -> Term:
    """Items whose body is non-zero; with no lambda, the route's length."""
    ...


def sum_edges(route: ListVar, func: _Body2, *, start: int = ..., end: int = ...) -> Term:
    """Sum ``body`` over the edges of the closed tour ``[start, items.., end]``."""
    ...


def item_pairs(route: ListVar, func: _Body2) -> Term:
