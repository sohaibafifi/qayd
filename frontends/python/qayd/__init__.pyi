"""Type stubs for qayd, a constraint-programming solver (PyO3 extension).

These stubs mirror the ``qayd._core`` API defined in
``src/frontends/python.rs`` and re-exported by ``qayd/__init__.py``.
"""
from typing import Any, Callable, Dict, Iterable, Optional, Sequence, Tuple, Union, overload

__all__: list[str]

# --- operand type aliases -------------------------------------------------
# Anything an arithmetic operator / comparison accepts on an IntVar or Expr.
_IntoExpr = Union["IntVar", "Expr", int]
# Anything the boolean combinators (&, |, implies, iff, all, any) accept.
_IntoBool = Union["Constraint", "IntVar", "Expr"]
# A value inside a list-domain lambda body: another symbolic node or an int.
_LambdaLike = Union["LambdaExpr", int]
_Body1 = Callable[["LambdaExpr"], _LambdaLike]
_Body2 = Callable[["LambdaExpr", "LambdaExpr"], _LambdaLike]
_Body3 = Callable[["LambdaExpr", "LambdaExpr", "LambdaExpr"], _LambdaLike]
_Body4 = Callable[["LambdaExpr", "LambdaExpr", "LambdaExpr", "LambdaExpr"], _LambdaLike]
# An assumption item accepted by solve(assumptions=...) / session.solve(...).
_Assumption = Union["Constraint", "IntVar", Tuple["IntVar", int], Tuple["IntVar", str, int]]
_Incumbent = Callable[[int, Dict[int, int]], Any]
_AnytimeCheckpoint = Tuple[int, int, bool, list[int], Optional[int], int]
_NeighborhoodProfile = Tuple[str, int, int, int, int, int, int, int, float]
_RoutingCounter = Tuple[str, int]

# A relation string such as "==", "!=", "<=", "<", ">=", ">".
STAR: int


