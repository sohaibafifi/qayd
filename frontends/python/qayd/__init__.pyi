# ===========================================================================
# Model
# ===========================================================================
class Model:
    """A constraint-programming model: declare variables, post constraints, solve."""

    def __init__(self) -> None: ...
    @property
    def num_vars(self) -> int: ...
    @property
    def num_constraints(self) -> int: ...
    @property
    def objective_sense(self) -> Optional[str]: ...
    @property
    def objective_expr(self) -> Optional[str]: ...

    # --- variable creation ---
    def int_var(
        self,
        lo: Optional[int] = ...,
        hi: Optional[int] = ...,
        *,
        values: Optional[Sequence[int]] = ...,
        name: Optional[str] = ...,
    ) -> IntVar: ...
    def bool_var(self, name: Optional[str] = ...) -> IntVar: ...
    def int_vars(self, n: int, lo: int, hi: int, *, name: Optional[str] = ...) -> list[IntVar]: ...
    def variables(self) -> list[IntVar]: ...
    def customers(self, items: Iterable[int]) -> CustomerSet: ...
    def routes(
        self,
        customers: Union[CustomerSet, Iterable[int]],
        *,
        vehicles: int,
        depot: int = ...,
        travel: Optional[Any] = ...,
        optional: bool = ...,
    ) -> RouteSet: ...
    def tasks(self, items: Iterable[int]) -> TaskSet: ...
    def schedule(
        self,
        tasks: Union[TaskSet, Iterable[int]],
        *,
        horizon: int,
        optional: bool = ...,
    ) -> ScheduleSet: ...

    # --- posting constraints ---
    def add(
        self,
        constraint: Union[
            Constraint,
            ListConstraint,
            ScanResourceConstraint,
            VisitConstraint,
            ScheduleConstraint,
            Iterable[Union[Constraint, ListConstraint, ScanResourceConstraint, VisitConstraint, ScheduleConstraint]],
        ],
    ) -> None: ...
    def linear(self, coeffs: Sequence[int], vars: Iterable[IntVar], relation: str, rhs: int) -> None: ...
    def sum(self, vars: Iterable[IntVar], relation: str, rhs: int) -> None: ...
    def all_different(self, vars: Iterable[IntVar]) -> None: ...
    def all_equal(self, vars: Iterable[IntVar]) -> None: ...
    def not_equal(self, x: IntVar, y: IntVar) -> None: ...
    def not_equal_offset(self, x: IntVar, y: IntVar, offset: int = ...) -> None: ...
    def ordered(self, vars: Iterable[IntVar], relation: str) -> None: ...
    def instantiate(self, vars: Iterable[IntVar], values: Sequence[int]) -> None: ...
    def minimum(self, target: IntVar, vars: Iterable[IntVar]) -> None: ...
    def maximum(self, target: IntVar, vars: Iterable[IntVar]) -> None: ...
    def element(self, array: Iterable[IntVar], index: IntVar, value: IntVar) -> None: ...
    def element_const(self, array: Sequence[int], index: IntVar, value: IntVar) -> None: ...
    def count(self, vars: Iterable[IntVar], value: int, relation: str, k: int) -> None: ...
    def cardinality(
        self,
        vars: Iterable[IntVar],
        values: Sequence[int],
        low: Sequence[int],
        high: Sequence[int],
        *,
        closed: bool = ...,
    ) -> None: ...
    def n_values(self, vars: Iterable[IntVar], relation: str, k: int) -> None: ...
    def table(self, vars: Iterable[IntVar], tuples: Sequence[Sequence[int]], *, positive: bool = ...) -> None: ...
    def lex(self, x: Iterable[IntVar], y: Iterable[IntVar], *, strict: bool = ...) -> None: ...
    def lex_chain(self, rows: Iterable[Iterable[IntVar]], *, strict: bool = ...) -> None: ...
    def channel(self, x: Iterable[IntVar], y: Iterable[IntVar]) -> None: ...
    def no_overlap(
        self,
        items: Union[Iterable[IntVar], Iterable[IntervalVar]],
        durations: Optional[Sequence[int]] = ...,
    ) -> None: ...
    def sequence(self, items: Iterable[IntervalVar], transitions: Sequence[Sequence[int]]) -> SequenceVar: ...
    def cumulative(
        self, starts: Iterable[IntVar], durations: Sequence[int], heights: Sequence[int], capacity: int
    ) -> None: ...
    def cumulative_var(
        self,
        starts: Iterable[IntVar],
        durations: Iterable[IntVar],
        heights: Iterable[IntVar],
        capacity: IntVar,
    ) -> None: ...
    def bin_packing(self, items: Iterable[IntVar], sizes: Sequence[int], capacities: Sequence[int]) -> None: ...
    def knapsack(
        self,
        vars: Iterable[IntVar],
        weights: Sequence[int],
        profits: Sequence[int],
        weight_relation: str,
        weight_limit: int,
        profit_relation: str,
        profit_limit: int,
    ) -> None: ...
    def circuit(self, successors: Iterable[IntVar]) -> None: ...

    # --- list-domain (collection) modeling ---
    def list_vars(self, items: Sequence[int], count: int, *, optional: bool = ...) -> list[ListVar]: ...
    def set_vars(self, items: Sequence[int], count: int, *, optional: bool = ...) -> list[ListVar]: ...
    def list_value(self) -> ListValue: ...
    def precedence(self, before: Union[int, IntervalVar], after: Union[int, IntervalVar]) -> None: ...
    def same_list(self, a: int, b: int) -> None: ...
    def different_list(self, a: int, b: int) -> None: ...
    def all_same_list(self, items: Sequence[int]) -> None: ...
    def all_different_lists(self, items: Sequence[int]) -> None: ...
    def list_distance(self, a: int, b: int, *, min: int = ..., max: int = ...) -> None: ...

    # --- interval (scheduling) modeling ---
    def interval(self, duration: int, horizon: int, *, optional: bool = ..., name: Optional[str] = ...) -> IntervalVar: ...
    def intervals(
        self, durations: Sequence[int], horizon: int, *, optional: bool = ..., name: Optional[str] = ...
    ) -> list[IntervalVar]: ...
    def schedule_intervals(
        self, durations: Sequence[int], horizon: int, *, optional: bool = ...
    ) -> list[IntervalVar]: ...
    def alternatives(self, modes: Sequence[Sequence[Tuple[int, int]]], horizon: int) -> list[IntervalVar]: ...
    def alternative(
        self, members: Sequence[IntervalVar], *, optional: bool = ..., name: Optional[str] = ...
    ) -> IntervalVar:
        """One member executes while the master is present. An optional master
        and all of its members may be absent."""
        ...
    def no_overlap_by_machine(self) -> None: ...
    def minimize_makespan(self, intervals: Optional[Iterable[IntervalVar]] = ...) -> None: ...
    def resource(self, demands: Sequence[Tuple[IntervalVar, int]], capacity: int) -> None: ...
    def resource_calendar(
        self,
        demands: Sequence[Tuple[IntervalVar, int]],
        default_capacity: int,
        calendar: Sequence[Tuple[int, int, int]],
    ) -> None: ...
    def state_function(
        self,
        states: Sequence[Tuple[IntervalVar, int]],
        transitions: Sequence[Sequence[int]],
    ) -> None: ...

    # --- objectives ---
    def minimize(self, objective: Union[IntVar, Expr, Term, ScheduleMakespanObjective]) -> None: ...
    def maximize(self, objective: Union[IntVar, Expr, Term]) -> None: ...
    def then_minimize(self, objective: Union[IntVar, Expr, Term]) -> None: ...
    def then_maximize(self, objective: Union[IntVar, Expr, Term]) -> None: ...

    # --- solving ---
    def solve(
        self,
        *,
        search: Optional[Iterable[IntVar]] = ...,
        assumptions: Optional[Iterable[_Assumption]] = ...,
        hints: Optional[Iterable[Tuple[IntVar, int]]] = ...,
        branch_order: Optional[Iterable[IntVar]] = ...,
        on_incumbent: Optional[_Incumbent] = ...,
        verbose: bool = ...,
        time_limit: Optional[int] = ...,
        seed: int = ...,
        threads: int = ...,
        engine: str = ...,
        conflict_budget: Optional[int] = ...,
        list_hint: Optional[list[list[int]]] = ...,
        max_iterations: Optional[int] = ...,
        profile: bool = ...,
        memory_limit_mb: Optional[int] = ...,
        schedule_cdcl: bool = ...,
        routing_two_way: bool = ...,
        routing_nearest_neighbor: bool = ...,
        routing_warm_start: bool = ...,
        linear_backend: str = ...,
        lp_root_ms: int = ...,
        lp_node_ms: int = ...,
        lp_node_depth_interval: int = ...,
        lp_max_variables: int = ...,
        lp_max_rows: int = ...,
        lp_max_nonzeros: int = ...,
        lp_min_coverage_percent: int = ...,
        lp_phase_max_variables: int = ...,
        lp_route_ng_size: int = ...,
        lp_route_max_labels: int = ...,
        lp_route_dual_stabilization_percent: int = ...,
    ) -> Solution: ...
    def count_solutions(self, search: Optional[Iterable[IntVar]] = ...) -> int: ...
    def session(self) -> SolveSession: ...
    def __repr__(self) -> str: ...


