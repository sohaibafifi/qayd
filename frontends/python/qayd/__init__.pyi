# ===========================================================================
class IntVar:
    """An integer decision variable handle bound to its owning Model."""

    @property
    def index(self) -> int: ...
    @property
    def name(self) -> Optional[str]: ...
    def expr(self) -> Expr: ...
    def __repr__(self) -> str: ...
    def __bool__(self) -> bool: ...
    def __neg__(self) -> Expr: ...
    def __abs__(self) -> Expr: ...
    def __add__(self, rhs: _IntoExpr) -> Expr: ...
    def __radd__(self, lhs: _IntoExpr) -> Expr: ...
    def __sub__(self, rhs: _IntoExpr) -> Expr: ...
    def __rsub__(self, lhs: _IntoExpr) -> Expr: ...
    def __mul__(self, rhs: _IntoExpr) -> Expr: ...
    def __rmul__(self, lhs: _IntoExpr) -> Expr: ...
    def __floordiv__(self, rhs: _IntoExpr) -> Expr: ...
    def __rfloordiv__(self, lhs: _IntoExpr) -> Expr: ...
    def __mod__(self, rhs: _IntoExpr) -> Expr: ...
    def __rmod__(self, lhs: _IntoExpr) -> Expr: ...
    def __lt__(self, rhs: _IntoExpr) -> Constraint: ...
    def __le__(self, rhs: _IntoExpr) -> Constraint: ...
    def __gt__(self, rhs: _IntoExpr) -> Constraint: ...
    def __ge__(self, rhs: _IntoExpr) -> Constraint: ...
    def __eq__(self, rhs: _IntoExpr) -> Constraint: ...  # type: ignore[override]
    def __ne__(self, rhs: _IntoExpr) -> Constraint: ...  # type: ignore[override]
    def __hash__(self) -> int: ...


class Expr:
    """A symbolic arithmetic expression over model variables."""

    def __repr__(self) -> str: ...
    def __bool__(self) -> bool: ...
    def __neg__(self) -> Expr: ...
    def __abs__(self) -> Expr: ...
    def __add__(self, rhs: _IntoExpr) -> Expr: ...
    def __radd__(self, lhs: _IntoExpr) -> Expr: ...
    def __sub__(self, rhs: _IntoExpr) -> Expr: ...
    def __rsub__(self, lhs: _IntoExpr) -> Expr: ...
    def __mul__(self, rhs: _IntoExpr) -> Expr: ...
    def __rmul__(self, lhs: _IntoExpr) -> Expr: ...
    def __floordiv__(self, rhs: _IntoExpr) -> Expr: ...
    def __rfloordiv__(self, lhs: _IntoExpr) -> Expr: ...
    def __mod__(self, rhs: _IntoExpr) -> Expr: ...
    def __rmod__(self, lhs: _IntoExpr) -> Expr: ...
    def __lt__(self, rhs: _IntoExpr) -> Constraint: ...
    def __le__(self, rhs: _IntoExpr) -> Constraint: ...
    def __gt__(self, rhs: _IntoExpr) -> Constraint: ...
    def __ge__(self, rhs: _IntoExpr) -> Constraint: ...
    def __eq__(self, rhs: _IntoExpr) -> Constraint: ...  # type: ignore[override]
    def __ne__(self, rhs: _IntoExpr) -> Constraint: ...  # type: ignore[override]
    def __hash__(self) -> int: ...


class Constraint:
    """A boolean constraint, built by comparing/combining expressions."""

    def __repr__(self) -> str: ...
    def __bool__(self) -> bool: ...
    def __invert__(self) -> Constraint: ...
    def __and__(self, rhs: _IntoBool) -> Constraint: ...
    def __or__(self, rhs: _IntoBool) -> Constraint: ...
    def implies(self, rhs: _IntoBool) -> Constraint: ...
    def iff(self, rhs: _IntoBool) -> Constraint: ...


class ListVar:
    """An ordered list or unordered set handle from Model.list_vars()/set_vars()."""

    @property
    def index(self) -> int: ...
    def __repr__(self) -> str: ...


class IntervalVar:
    """An interval (scheduling) decision-variable handle."""

    @property
    def index(self) -> Optional[int]:
        """Backing native-interval index; ``None`` for a moded master."""
        ...
    @property
    def start(self) -> Optional[IntVar]: ...
    @property
    def presence(self) -> Optional[IntVar]: ...
    @property
    def optional(self) -> bool: ...
    @property
    def duration(self) -> Optional[int]: ...
    @property
    def end(self) -> Expr:
        """``start + duration``; for an alternative master, ``start + realized_duration``."""
        ...
    @property
    def realized_duration(self) -> Expr:
        """``Σ p_m·d_m`` of an alternative master; raises otherwise."""
        ...
    @property
    def members(self) -> list[IntervalVar]:
        """Member intervals of an alternative master (empty otherwise)."""
        ...
    def __repr__(self) -> str: ...


class SequenceVar:
    """A native interval sequence with sequence-dependent setup times."""

    @property
    def index(self) -> int: ...
    @property
    def intervals(self) -> list[IntervalVar]: ...
    def order(self, solution: "Solution") -> list[IntervalVar]: ...
    def __repr__(self) -> str: ...


# ===========================================================================
# List-domain (collection) modeling helpers
# ===========================================================================
class LambdaExpr:
    """A symbolic node in a list-domain lambda body."""

    def __add__(self, other: _LambdaLike) -> LambdaExpr: ...
    def __radd__(self, other: _LambdaLike) -> LambdaExpr: ...
    def __sub__(self, other: _LambdaLike) -> LambdaExpr: ...
    def __rsub__(self, other: _LambdaLike) -> LambdaExpr: ...
    def __mul__(self, other: _LambdaLike) -> LambdaExpr: ...
    def __rmul__(self, other: _LambdaLike) -> LambdaExpr: ...
    def __mod__(self, other: _LambdaLike) -> LambdaExpr: ...
    def __rmod__(self, other: _LambdaLike) -> LambdaExpr: ...
    def __pow__(self, exponent: int, modulo: None = ...) -> LambdaExpr: ...
    def __neg__(self) -> LambdaExpr: ...
    def __floordiv__(self, other: _LambdaLike) -> LambdaExpr: ...
    def __rfloordiv__(self, other: _LambdaLike) -> LambdaExpr: ...
    def __lt__(self, other: _LambdaLike) -> LambdaExpr: ...
    def __le__(self, other: _LambdaLike) -> LambdaExpr: ...
    def __gt__(self, other: _LambdaLike) -> LambdaExpr: ...
    def __ge__(self, other: _LambdaLike) -> LambdaExpr: ...


class Array:
    """A constant integer array; index it with a lambda arg to read array[i]."""

    def __getitem__(self, idx: _LambdaLike) -> LambdaExpr: ...
    def __len__(self) -> int: ...


class Matrix:
    """A constant integer matrix; matrix[i][j] reads a cell."""

    def __getitem__(self, row: _LambdaLike) -> MatrixRow: ...


class MatrixRow:
    """The partially indexed matrix[i]; index again for matrix[i][j]."""

    def __getitem__(self, col: _LambdaLike) -> LambdaExpr: ...


class Term:
    """A term over one or more list variables."""

    def __add__(self, other: Term) -> Term: ...
    def __radd__(self, other: int) -> Term: ...
    def __mul__(self, other: int) -> Term: ...
    def __rmul__(self, other: int) -> Term: ...
    def __neg__(self) -> Term: ...
    def __le__(self, other: int | ListValue) -> ListConstraint | Reified: ...
    def __ge__(self, other: int | ListValue) -> ListConstraint | Reified: ...
    def __eq__(self, other: int | ListValue) -> ListConstraint | Reified: ...  # type: ignore[override]
    def __hash__(self) -> int: ...


class ListConstraint:
    """A constraint ``term <op> rhs`` over a single list reduction."""


class ListValue:
    """A collection-scoped scalar minted by ``Model.list_value()``; bind a scan
    total to it with ``add(scan == v)``, then use it in a linear objective."""

    def __add__(self, other: Term | ListValue) -> Term: ...
    def __radd__(self, other: Term | int) -> Term: ...
    def __mul__(self, other: int) -> Term: ...
    def __rmul__(self, other: int) -> Term: ...
    def __neg__(self) -> Term: ...


class Reified:
    """A reified binding ``scan == list_value``, recorded by ``Model.add``."""


class ScanResourceConstraint:
    """A constraint over a deterministic resource scan."""


class ScanResourcePointExpr:
    """A named resource view at one list item."""

    def __le__(self, rhs: int) -> ScanResourceConstraint: ...
    def __ge__(self, rhs: int) -> ScanResourceConstraint: ...
    def __eq__(self, rhs: object) -> ScanResourceConstraint: ...  # type: ignore[override]
    def __hash__(self) -> int: ...


class ScanResource:
    """A deterministic state threaded along one list variable."""

    def view(self, name: str, projection: _Body3) -> ScanResource: ...
    def at(self, item: int, *, view: str = ...) -> ScanResourcePointExpr: ...
    def after(self, item: int) -> ScanResourcePointExpr: ...
    def before(self, item: int) -> ScanResourcePointExpr: ...
    def within_bounds(
        self,
        *,
        view: str = ...,
        lower: Optional[int] = ...,
        upper: Optional[int] = ...,
    ) -> ScanResourceConstraint: ...


