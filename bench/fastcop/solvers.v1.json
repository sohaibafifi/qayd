{
  "checker": {
    "argv": [
      "java",
      "-XX:ActiveProcessorCount=1",
      "-Xmx{checker_heap_mb}m",
      "-cp",
      "{ace_artifact}",
      "org.xcsp.parser.callbacks.SolutionChecker",
      "{instance}",
      "-cm"
    ],
    "artifact": "../solvers/ACE-2.5.jar",
    "expected_sha256": "cb0d0741d7f626c5166371efa2ce8cbe5dc62c49f10180e3ebf4be008106dcc7",
    "name": "XCSP3 SolutionChecker from ACE 2.5"
  },
  "schema": "qayd.fastcop.solvers/v1",
  "solvers": {
    "ace": {
      "argv": [
        "java",
        "-XX:ActiveProcessorCount=1",
        "-Xmx{java_heap_mb}m",
        "-jar",
        "{artifact}",
        "{instance}",
        "-t={cpu_seconds}s",
        "-seed={seed}",
        "-npc",
        "-v=-1"
      ],
      "artifact": "../solvers/ACE-2.5.jar",
      "expected_sha256": "cb0d0741d7f626c5166371efa2ce8cbe5dc62c49f10180e3ebf4be008106dcc7",
      "version": "ACE 2.5 (PyCSP3 2.5 competition binary)"
    },
    "ace-rr": {
      "argv": [
        "java",
        "-XX:ActiveProcessorCount=1",
        "-Xmx{java_heap_mb}m",
        "-jar",
        "{artifact}",
        "{instance}",
        "-t={cpu_seconds}s",
        "-seed={seed}",
        "-npc",
        "-rr",
        "-v=-1"
      ],
      "artifact": "../solvers/ACE-2.5.jar",
      "expected_sha256": "cb0d0741d7f626c5166371efa2ce8cbe5dc62c49f10180e3ebf4be008106dcc7",
      "version": "ACE 2.5 (PyCSP3 2.5 competition binary), round-robin restarts"
    },
    "choco": {
      "argv": [
        "java",
        "-XX:ActiveProcessorCount=1",
        "-Xmx{java_heap_mb}m",
        "-cp",
        "{artifact}",
        "org.chocosolver.parser.xcsp.ChocoXCSP",
        "-limit={cpu_seconds}s",
        "-p",
        "1",
        "-seed",
        "{seed}",
        "-lvl",
        "COMPET",
        "{instance}"
      ],
      "artifact": "../solvers/choco-xcsp25.jar",
      "expected_sha256": "6dec5d54b335a18170314539e6c5ecc779778600154db28b59cffacdca898600",
      "version": "Choco Parser 5.0.0-beta.1 (XCSP25)"
    },
    "qayd": {
      "argv": [
        "{artifact}",
        "-t",
        "{cpu_seconds}",
        "--threads",
        "1",
        "--seed",
        "{seed}",
        "--verbose",
        "--mem-limit",
        "{memory_mb}",
        "{instance}"
      ],
      "artifact": "../../target/release/qayd",
      "expected_sha256": null,
      "version": "qayd 0.9.1 workspace release; exact executable SHA-256 recorded per run"
    }
  }
}
